[Unit]
Description=resoFlow FastAPI Backend API Container
After=resoflow-pod.service resoflow-postgres.service resoflow-redis.service
Wants=resoflow-postgres.service resoflow-redis.service
BindsTo=resoflow-pod.service

[Service]
Restart=always
TimeoutStartSec=120
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
SyslogIdentifier=%N
Delegate=yes
Type=notify
NotifyAccess=all
ExecStop=-/usr/bin/podman rm -v -f -i resoflow-api
ExecStopPost=-/usr/bin/podman rm -v -f -i resoflow-api
ExecStart=/usr/bin/podman run --name resoflow-api --replace --rm --cgroups=split --sdnotify=conmon -d -v __DATA_DIR__:/data/projects:z --env-file %h/.config/resoflow/resoflow.env --pod resoflow localhost/resoflow-api:latest sh -c "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port \${API_PORT:-8000}"

[Install]
WantedBy=default.target
